{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ONE CORE AI",
  "version": "0.2.1",
  "identifier": "com.onecoreai.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:3000",
    "beforeBuildCommand": "npm run build && npm run tauri:prepare",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ONE CORE AI — локальный ИИ-агент",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 700,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "externalBin": ["binaries/llama-server"],
    "resources": {
      "../dist/backend.cjs": "backend.cjs",
      "runtime/node.exe": "node.exe"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "displayLanguageSelector": false,
        "languages": ["Russian", "English"]
      }
    }
  }
}
