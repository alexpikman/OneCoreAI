{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onecore.ai/schemas/worker-result.v1.schema.json",
  "title": "ONE CORE AI Specialist Worker Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "taskId",
    "operationId",
    "status",
    "summary",
    "findings",
    "filesInspected",
    "checks",
    "unresolvedQuestions",
    "limitations"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "taskId": { "type": "string", "minLength": 1, "maxLength": 120 },
    "operationId": { "type": "string", "minLength": 1, "maxLength": 120 },
    "status": {
      "enum": ["completed", "blocked", "needs_more_context", "failed", "cancelled"]
    },
    "summary": { "type": "string", "minLength": 1, "maxLength": 6000 },
    "findings": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "statement", "evidence", "impact", "recommendation"],
        "properties": {
          "severity": { "enum": ["critical", "high", "medium", "low", "info"] },
          "statement": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "evidence": {
            "type": "array",
            "maxItems": 30,
            "items": { "type": "string", "minLength": 1, "maxLength": 512 }
          },
          "impact": { "type": "string", "maxLength": 1500 },
          "recommendation": { "type": "string", "maxLength": 1500 }
        }
      }
    },
    "filesInspected": {
      "type": "array",
      "maxItems": 120,
      "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
    },
    "checks": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "status", "exitCode", "output"],
        "properties": {
          "command": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "status": { "enum": ["passed", "failed", "skipped", "unavailable"] },
          "exitCode": { "type": ["integer", "null"] },
          "output": { "type": "string", "maxLength": 4000 }
        }
      }
    },
    "unresolvedQuestions": {
      "type": "array",
      "maxItems": 50,
      "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
    },
    "limitations": {
      "type": "array",
      "maxItems": 50,
      "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
    }
  }
}
